<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="lweb_footer" name="L Web Footer">
        <footer class="lweb-footer footer">
            <div class="footer-container container">
                <div class="footer-grid">
                    <div class="footer-brand">
                        <div class="footer-logo">Vasilia</div>
                        <p class="footer-desc">
                            <t t-if="((request.lang and request.lang.code) or request.env.context.get('lang') or '').startswith('en')">Born from rare botanical extracts, powered by Nobel-winning science — Awaken your skin's innate radiance and confidence</t>
                            <t t-else="">源自珍稀植物精粹，融合诺贝尔奖级科研技术 — 唤醒肌肤本真光采，绽放自信魅力 — 为追求卓越的您，打造专属奢华护肤体验</t>
                        </p>
                        <div class="footer-social">
                            <a href="#" aria-label="微博" style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;overflow:hidden;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:18px;height:18px;display:block;flex:0 0 18px;">
                                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                    <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
                                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                                </svg>
                            </a>
                            <a href="#" aria-label="微信" style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;overflow:hidden;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:18px;height:18px;display:block;flex:0 0 18px;">
                                    <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path>
                                </svg>
                            </a>
                            <a href="#" aria-label="小红书" style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;overflow:hidden;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:18px;height:18px;display:block;flex:0 0 18px;">
                                    <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"></path>
                                </svg>
                            </a>
                        </div>
                    </div>

                    <div class="footer-links">
                        <h4>购物</h4>
                        <a t-att-href="url_localized('/shop')">产品系列</a>
                        <a t-att-href="url_localized('/shop/new-arrivals')">新品专区</a>
                        <a t-att-href="url_localized('/shop')">礼盒套装</a>
                    </div>

                    <div class="footer-links">
                        <h4>关于</h4>
                        <a t-att-href="url_localized('/lweb')">品牌故事</a>
                        <a t-att-href="url_localized('/lweb')">护肤服务</a>
                        <a t-att-href="url_localized('/lweb')">美妆资讯</a>
                    </div>

                    <div class="footer-links">
                        <h4>服务</h4>
                        <a t-att-href="url_localized('/contactus')">联系我们</a>
                        <a t-att-href="url_localized('/lweb')">常见问题</a>
                        <a t-att-href="url_localized('/lweb')">肌肤测评</a>
                    </div>

                    <div class="footer-newsletter">
                        <h4>加入vasilia尊享会</h4>
                        <p>第一时间获取新品发布和美妆资讯</p>
                        <form class="newsletter-form" t-att-action="'#'" onsubmit="return false;">
                            <input type="email" placeholder="输入您的邮箱"/>
                            <button type="submit">→</button>
                        </form>
                    </div>
                </div>

                <div class="footer-bottom">
                    <p>© 2024 vasilia. 保留所有权利。</p>
                    <div class="footer-legal">
                        <a t-att-href="url_localized('/privacy')">隐私政策</a>
                        <a t-att-href="url_localized('/terms')">服务条款</a>
                    </div>
                </div>
            </div>
        </footer>
    </template>

    <template id="lweb_newsletter_section" name="L Web Newsletter Section">
        <section class="newsletter-section">
            <div class="container">
                <div class="newsletter-content">
                    <h2>加入vasilia尊享会</h2>
                    <p>第一时间获取新品发布和美妆资讯</p>
                    <form class="newsletter-form" t-att-action="'#'" onsubmit="return false;">
                        <input type="email" placeholder="输入您的邮箱"/>
                        <button type="submit" class="btn btn-primary">探索系列</button>
                    </form>
                </div>
            </div>
        </section>
    </template>

    <template id="lweb_back_to_top" name="L Web Back To Top">
        <button class="back-to-top" type="button" aria-label="返回顶部">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
        </button>
    </template>
</odoo>
